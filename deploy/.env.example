# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# There are no API keys in this file, and there never will be: nothing in this
# system talks to a service outside the deployment.
# ---------------------------------------------------------------------------

# --- database --------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- graph store (optional; NetworkX fallback if absent) --------------------
NEO4J_PASSWORD=change-me

# --- local model runtime ---------------------------------------------------
# Off unless this is set. A model that merely happens to be listening on
# loopback is NOT adopted: an audit has to give the same answer twice, and
# picking one up would make two machines disagree about the same configuration.
CRUCIBLE_OLLAMA=0
# Model must already be present in the ollama image. A runtime pull defeats the
# deployment story and fails the egress test.
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- parsing cascade thresholds -------------------------------------------
# Printed in the report so an auditor sees the posture the run used.
TIER2_CONFIDENCE_APPLY=0.85
TIER2_CONFIDENCE_ASSERT_ONLY=0.60

# --- verification sandbox --------------------------------------------------
CRUCIBLE_SANDBOX_ENABLED=1
CRUCIBLE_SANDBOX_TIMEOUT_SECONDS=15
CRUCIBLE_SANDBOX_SEVERITIES=critical,high

# --- integrity -------------------------------------------------------------
# Generated at installation, never leaves the host, never committed.
LEDGER_SIGNING_KEY_PATH=/var/lib/crucible/signing/ed25519.key
ADAPTER_TRUST_STORE_PATH=/var/lib/crucible/trust

# --- air gap ---------------------------------------------------------------
CRUCIBLE_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
