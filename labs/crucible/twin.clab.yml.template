# ---------------------------------------------------------------------------
# Crucible twin topology - TEMPLATE
#
# Generated by crucible.sandbox, never edited by hand. Rendered per finding,
# deployed, probed, and destroyed. Placeholders are substituted at render time.
#
# Constraints that are part of the design, not of the implementation:
#   - isolated bridge, no egress
#   - ephemeral, destroyed after every run including on failure
#   - no production credentials; rendering strips credential material
# ---------------------------------------------------------------------------

name: crucible-twin-{{ run_id }}

mgmt:
  network: crucible-{{ run_id }}
  ipv4-subnet: 172.31.{{ octet }}.0/24
  external-access: false          # no egress. this line is the whole safety story

topology:
  nodes:

    # The twin: the audited device, rendered from the IR into VyOS.
    twin:
      kind: vr-vyos
      image: vyos/vyos:1.4
      startup-config: {{ rendered_config_path }}
      labels:
        crucible.run: "{{ run_id }}"
        crucible.source-device: "{{ device_serial }}"
        crucible.finding: "{{ finding_id }}"

    # The probe host, standing in for an untrusted segment. Carries nmap, ssh,
    # snmpwalk, curl and tcpdump. Its output is the proof artefact attached to
    # the finding.
    probe:
      kind: linux
      image: crucible/probe:0.1.0
      labels:
        crucible.run: "{{ run_id }}"
        crucible.role: "untrusted-segment"

    # Optional. Present only for regression checks that need a legitimate peer:
    # BGP still up, syslog still reaching, management still reachable.
    peer:
      kind: linux
      image: frrouting/frr:latest
      labels:
        crucible.run: "{{ run_id }}"
        crucible.role: "legitimate-peer"

  links:
    - endpoints: ["twin:eth1", "probe:eth1"]
    - endpoints: ["twin:eth2", "peer:eth1"]

# ---------------------------------------------------------------------------
# Run sequence, from docs/07-crucible-sandbox.md:
#
#   PHASE 1  demonstrate  - probe reaches the weakness, capture it
#   PHASE 2  remediate    - apply the exact CLI printed in the PDF, in order
#   PHASE 3  re-test      - the same probes are now refused
#   PHASE 4  regression   - BGP up, VLAN reachable, syslog flowing, no lockout
#
# Boot failure or an unsupported property degrades the finding to ASSERTED.
# Never to a false DEMONSTRATED, and never to a false pass.
# ---------------------------------------------------------------------------
